{
  "openapi": "3.1.0",
  "info": {
    "title": "Isla Skills",
    "version": "1.0.0",
    "summary": "An app store for robot skills, paid per use with x402 on Solana devnet.",
    "description": "Each skill is an HTTP service a robot or AI agent pays per call, in devnet USDC on Solana, with x402 v1 (scheme `exact`, network `solana-devnet`). Calling a skill without payment returns 402 with the price and the skill maker's wallet; pay with your own devnet wallet in the `X-PAYMENT` header. Devnet only: test USDC, never real money. Guide for agents: https://isla-skills-dao-2b40fb.netlify.app/.well-known/agent-skills/isla-skills/SKILL.md",
    "license": {
      "name": "MIT",
      "url": "https://github.com/katamar-lang/isla-skills/blob/main/LICENSE"
    }
  },
  "servers": [
    {
      "url": "https://isla-skills-dao-2b40fb.netlify.app"
    }
  ],
  "externalDocs": {
    "description": "llms.txt",
    "url": "https://isla-skills-dao-2b40fb.netlify.app/llms.txt"
  },
  "paths": {
    "/api/skills/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "litter-spotter",
              "human-reviewer",
              "cleanup-planner"
            ]
          }
        }
      ],
      "get": {
        "operationId": "getSkill",
        "summary": "One skill: name, kind, price and payout wallet",
        "responses": {
          "200": {
            "description": "The skill",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Skill"
                }
              }
            }
          },
          "404": {
            "description": "Unknown skill",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "callSkill",
        "summary": "Call a skill and pay for it with x402",
        "description": "Without `X-PAYMENT`: 402 with the payment requirements. With a valid payment: the store verifies it with an x402 facilitator, does the work, settles, and returns the result. If the work fails, the payment is not settled. The same `X-PAYMENT` sent again returns the saved result (`X-Replay: 1`) and is never charged twice.\n\nBodies: `litter-spotter` {image}; `cleanup-planner` {items}; `human-reviewer` {spotId} to start a review, then {reviewId} to poll (202 waiting, 402 once a person answered, 410 after 20 s), {reviewId, cancel:true} to stop waiting.",
        "parameters": [
          {
            "name": "X-PAYMENT",
            "in": "header",
            "required": false,
            "description": "Base64 JSON x402 v1 payment payload: {x402Version:1, scheme:'exact', network:'solana-devnet', payload:{transaction:<base64 signed Solana tx>}}. Leave it out to get the 402 with the price.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "title": "Litter Spotter",
                    "type": "object",
                    "properties": {
                      "image": {
                        "type": "string",
                        "description": "data:image/jpeg|png|webp;base64,… (at most about 650 KB)"
                      }
                    },
                    "required": [
                      "image"
                    ]
                  },
                  {
                    "title": "Cleanup Planner",
                    "type": "object",
                    "properties": {
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "enum": [
                                "plastic_bottle",
                                "plastic_bag",
                                "cup_or_straw",
                                "food_wrapper",
                                "cigarette_butt",
                                "can",
                                "glass",
                                "fishing_gear_or_rope",
                                "styrofoam",
                                "paper_or_cardboard",
                                "other"
                              ]
                            },
                            "label": {
                              "type": "string"
                            },
                            "count": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "where": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "type"
                          ]
                        }
                      }
                    },
                    "required": [
                      "items"
                    ]
                  },
                  {
                    "title": "Human Reviewer",
                    "type": "object",
                    "properties": {
                      "spotId": {
                        "type": "string"
                      },
                      "reviewId": {
                        "type": "string"
                      },
                      "cancel": {
                        "type": "boolean"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paid result",
            "headers": {
              "X-PAYMENT-RESPONSE": {
                "description": "Base64 JSON with the settlement (Solana transaction signature).",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "description": "The skill's answer (Litter Spotter: place, items, unsure, spotId; Cleanup Planner: steps, minutes, recyclablePercent; Human Reviewer: answer, reviewer)"
                    },
                    "payment": {
                      "type": "object",
                      "properties": {
                        "transaction": {
                          "type": "string"
                        },
                        "amount": {
                          "type": "string"
                        },
                        "payTo": {
                          "type": "string"
                        },
                        "asset": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "202": {
            "description": "Human Reviewer: waiting for a person",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "reviewId": {
                      "type": "string"
                    },
                    "secondsLeft": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "402": {
            "description": "Payment required (x402 v1). Pay `accepts[0]` and send the same request again with the `X-PAYMENT` header.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentRequired"
                }
              }
            }
          },
          "410": {
            "description": "Human Reviewer: nobody answered in time, or the review was skipped. Nothing to pay.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "reviewId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Photo limit reached (5 per visitor a day, 100 in total)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "The AI isn't switched on",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "x402": []
          },
          {}
        ]
      }
    },
    "/api/coco": {
      "get": {
        "operationId": "getCoco",
        "summary": "Coco's wallet: address, devnet USDC balance, daily budget, photo limits, and the skills with their payout wallets",
        "responses": {
          "200": {
            "description": "Coco's status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "address": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "usdcUnits": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "budget": {
                      "type": "object",
                      "properties": {
                        "day": {
                          "type": "string"
                        },
                        "limitUnits": {
                          "type": "integer"
                        },
                        "spentUnits": {
                          "type": "integer"
                        }
                      }
                    },
                    "photos": {
                      "type": "object"
                    },
                    "facilitator": {
                      "type": "string"
                    },
                    "skills": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Skill"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      }
    },
    "/api/stats": {
      "get": {
        "operationId": "getStats",
        "summary": "Usage read from Solana devnet: photos analyzed, paid skill calls, USDC paid to skill makers, people paid for reviews",
        "responses": {
          "200": {
            "description": "Totals (`counting` > 0 while older payments are still being read; `stale` when Solana is slow)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ready": {
                      "type": "boolean"
                    },
                    "photos": {
                      "type": "integer"
                    },
                    "paidCalls": {
                      "type": "integer"
                    },
                    "paidUnits": {
                      "type": "integer"
                    },
                    "reviewers": {
                      "type": "integer"
                    },
                    "perSkill": {
                      "type": "object"
                    },
                    "counting": {
                      "type": "integer"
                    },
                    "stale": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      }
    },
    "/api/reviews": {
      "get": {
        "operationId": "listReviews",
        "summary": "Photos waiting for a person (with ?wallet= also that person's recent reviews)",
        "parameters": [
          {
            "name": "wallet",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pending reviews",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "pending": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Review"
                      }
                    },
                    "mine": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Review"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      }
    },
    "/api/reviews/{id}/image": {
      "get": {
        "operationId": "getReviewImage",
        "summary": "The photo to review",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "JPEG, PNG or WebP image",
            "content": {
              "image/*": {}
            }
          },
          "404": {
            "description": "Unknown review"
          }
        }
      }
    },
    "/api/reviews/{id}/answer": {
      "post": {
        "operationId": "answerReview",
        "summary": "Answer a review; the robot pays the wallet that answered (0.005 devnet USDC) if it is still waiting",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "answer": {
                    "type": "string",
                    "enum": [
                      "litter",
                      "not_litter"
                    ]
                  },
                  "wallet": {
                    "type": "string",
                    "description": "Your Solana address"
                  }
                },
                "required": [
                  "answer",
                  "wallet"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Answer saved"
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "410": {
            "description": "Too late: the review closed"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Skill": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "price": {
            "type": "integer",
            "description": "USDC base units (6 decimals)"
          },
          "priceUsdc": {
            "type": "number"
          },
          "does": {
            "type": "string"
          },
          "payTo": {
            "type": "string",
            "description": "The skill maker's payout wallet (Human Reviewer: the person who answers)"
          }
        }
      },
      "Review": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "litterOption": {
            "type": "string"
          },
          "notLitterOption": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "secondsLeft": {
            "type": "integer"
          },
          "image": {
            "type": "string"
          },
          "priceUsdc": {
            "type": "number"
          }
        }
      },
      "PaymentRequired": {
        "type": "object",
        "properties": {
          "x402Version": {
            "type": "integer",
            "const": 1
          },
          "error": {
            "type": "string"
          },
          "accepts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "scheme": {
                  "type": "string",
                  "const": "exact"
                },
                "network": {
                  "type": "string",
                  "const": "solana-devnet"
                },
                "maxAmountRequired": {
                  "type": "string"
                },
                "resource": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "mimeType": {
                  "type": "string"
                },
                "payTo": {
                  "type": "string"
                },
                "maxTimeoutSeconds": {
                  "type": "integer"
                },
                "asset": {
                  "type": "string",
                  "description": "Devnet USDC mint 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU"
                },
                "extra": {
                  "type": "object",
                  "properties": {
                    "feePayer": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "x402": {
        "type": "apiKey",
        "in": "header",
        "name": "X-PAYMENT",
        "description": "Not a key: a per-call x402 v1 payment payload (base64). Only skill calls need it; read endpoints are free."
      }
    }
  },
  "security": []
}
